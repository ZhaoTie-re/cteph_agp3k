    "MAF_ALL", "MAF_CASE", "MAF_CTRL",
    "HWE_ALL", "HWE_CASE", "HWE_CTRL",
    "IMPUTED_R2"
  ],
  "supported_operators": ["<", "<=", ">", ">=", "==", "!="]
}
