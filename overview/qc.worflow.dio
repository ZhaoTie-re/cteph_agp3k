                <mxCell id="N7_mkgsrad50ErjP7LUE-79" value="&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\textbf{Platform-specific Genotype Consistency Metrics:}\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\text{For parameter } \boldsymbol{\theta} = (\text{DP}, \text{GQ}, \text{LAF}, \text{HAF})\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\text{Consistency}_{15X}^{\text{local}}(\boldsymbol{\theta})\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\text{Consistency}_{30X}^{\text{local}}(\boldsymbol{\theta})\)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=default;dashed=1;rounded=1;arcSize=16;" parent="79" vertex="1">
                    <mxGeometry x="17" y="80" width="460" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="9YAMM4m1q-vV5Q4zW8u_-79" value="&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\textbf{Local Sample Proportions:}\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(p_{15X}^{\text{local}} = \frac{n_{15X}^{\text{local}}}{n_{15X}^{\text{local}} + n_{30X}^{\text{local}}}\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(p_{30X}^{\text{local}} = \frac{n_{30X}^{\text{local}}}{n_{15X}^{\text{local}} + n_{30X}^{\text{local}}}\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 9px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=default;dashed=1;glass=0;shadow=0;rounded=1;arcSize=24;" parent="79" vertex="1">
                    <mxGeometry x="537" y="80" width="510" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="vT_qNB_NnREo19xz4tkL-79" value="&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;\(\textbf{Expected Local Genotype Consistency:}\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\text{ExpectedConsistency}^{\text{local}}(\boldsymbol{\theta}) = p_{15X}^{\text{local}} \cdot \text{Consistency}_{15X}^{\text{local}}(\boldsymbol{\theta}) + p_{30X}^{\text{local}} \cdot \text{Consistency}_{30X}^{\text{local}}(\boldsymbol{\theta})\)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=default;" parent="79" vertex="1">
                    <mxGeometry x="-353" y="220" width="1200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="UmxKLcg6jyb-rUaQMxyM-79" value="&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\textbf{Observed Local Genotype Consistency:}\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\text{ObservedConsistency}^{\text{local}}(\boldsymbol{\theta}) = \text{Genotype consistency of all local samples under } \boldsymbol{\theta}\)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=default;" parent="79" vertex="1">
                    <mxGeometry x="437" y="220" width="710" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="j0XYsdZJ894xV05qrIqr-79" value="&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\textbf{Validation:}\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\text{If } \text{ObservedConsistency}^{\text{local}}(\boldsymbol{\theta}) \approx \text{ExpectedConsistency}^{\text{local}}(\boldsymbol{\theta})\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\Rightarrow \text{Platform-compositional expectation holds}\)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=default;" parent="79" vertex="1">
