                <mxCell id="BNFqxmIFnhx2oiVevb6w-85" value="Stage 4: Global Genotype Consistency Projection &amp;amp; Genotype Parameter Tuning (Round 1 Tuning)" style="swimlane;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-76" y="1190" width="1173" height="460" as="geometry"/>
                </mxCell>
                <mxCell id="BNFqxmIFnhx2oiVevb6w-86" value="&lt;ul style=&quot;text-align: left;&quot;&gt;&lt;li&gt;&lt;b&gt;WGS matrix (global)&lt;/b&gt;&lt;/li&gt;&lt;li&gt;&lt;b&gt;Projection Logit&lt;/b&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=default;" parent="BNFqxmIFnhx2oiVevb6w-85" vertex="1">
                    <mxGeometry x="-18" y="20" width="180" height="80" as="geometry"/>
                </mxCell>
                <mxCell id="BNFqxmIFnhx2oiVevb6w-93" value="&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\textbf{Platform-specific Genotype Consistency Metrics:}\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\text{For parameter } \boldsymbol{\theta} = (\text{DP}, \text{GQ}, \text{LAF}, \text{HAF})\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\text{Consistency}_{15X}^{\text{local}}(\boldsymbol{\theta})\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px;&quot; color=&quot;#000000&quot;&gt;\(\text{Consistency}_{30X}^{\text{local}}(\boldsymbol{\theta})\)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=default;dashed=1;rounded=1;arcSize=16;" parent="BNFqxmIFnhx2oiVevb6w-85" vertex="1">
                    <mxGeometry x="20" y="90" width="460" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="v5CzWVJ53QZHJQIjBPVx-79" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;\(\textbf{Global Sample Proportions:}\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;\(p_{15X}^{\text{global}} = \frac{n_{15X}^{\text{global}}}{n_{15X}^{\text{global}} + n_{30X}^{\text{global}}}\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;\(p_{30X}^{\text{global}} = \frac{n_{30X}^{\text{global}}}{n_{15X}^{\text{global}} + n_{30X}^{\text{global}}}\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=default;" parent="BNFqxmIFnhx2oiVevb6w-85" vertex="1">
                    <mxGeometry x="458" y="90" width="580" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="9yCHhXEUFKasGd7yPlq5-79" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;\(\textbf{Projected Global Genotype Consistency:}\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;\(\text{EstimatedConsistency}^{\text{global}}(\boldsymbol{\theta}) = p_{15X}^{\text{global}} \cdot \text{Consistency}_{15X}^{\text{local}}(\boldsymbol{\theta}) + p_{30X}^{\text{global}} \cdot \text{Consistency}_{30X}^{\text{local}}(\boldsymbol{\theta})\)&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=12;fontColor=default;" parent="BNFqxmIFnhx2oiVevb6w-85" vertex="1">
                    <mxGeometry x="-112" y="240" width="1330" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="9yCHhXEUFKasGd7yPlq5-81" value="&lt;ul&gt;&lt;li&gt;&lt;b&gt;Evaluate global trade-off between:&lt;/b&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Estimated Genotype Concordance&lt;/li&gt;&lt;li&gt;Estimated Genotype Miss Rate&lt;/li&gt;&lt;/ul&gt;&lt;li&gt;&lt;b&gt;Validate:&lt;/b&gt;&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;b&gt;&lt;u&gt;Apply selected parameters (DP, GQ, LAF,HAF) to global genotype matrix&lt;/u&gt;&lt;/b&gt;&lt;/li&gt;&lt;li&gt;Check the AAF in shared variants between global &amp;amp; local&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="BNFqxmIFnhx2oiVevb6w-85" vertex="1">
                    <mxGeometry y="300" width="510" height="160" as="geometry"/>
                </mxCell>
                <mxCell id="9yCHhXEUFKasGd7yPlq5-80" value="" style="endArrow=classic;html=1;fontFamily=Helvetica;fontSize=12;fontColor=default;autosize=1;resizable=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="79" target="BNFqxmIFnhx2oiVevb6w-85" edge="1">
