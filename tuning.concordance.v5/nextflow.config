process {
    withName: 'FormatMatrixPrepare' {
        clusterOptions = '--rsc p=1:t=1:c=8:m=18234M'
    }
    withName: 'ConcordanceVmissCalculator' {
        clusterOptions = '--rsc p=1:t=2:c=4:m=13713M'
    }
    // withName: 'ConcordanceVmissCalculator' {
    //     // Dynamic Resource Strategy:
    //     // Attempt 1: c=2 (4.5GB) - Optimized for 1.5GB RSS usage.
    //     // Attempt 2: c=3 (9GB) - Fallback.
    //     // Attempt 3: c=4 (13GB) - For large chromosomes.
    //     // Attempt 4: c=6 (18GB) - Ultimate fallback.
    //     errorStrategy = { task.exitStatus == 143 ? 'retry' : 'ignore' }
    //     maxRetries = 3
    //     clusterOptions = { 
    //         if (task.attempt == 1) return '--rsc p=1:t=2:c=2:m=4571M'
    //         else if (task.attempt == 2) return '--rsc p=1:t=2:c=3:m=9142M'
    //         else if (task.attempt == 3) return '--rsc p=1:t=2:c=4:m=13713M'
    //         else return '--rsc p=1:t=2:c=6:m=18234M'
    //     }
    // }
    withName: 'ConcordanceVmissSummary' {
        // Dynamic Resource Strategy:
        // Attempt 1: c=2 (4.5GB) - Optimized for low usage.
        // Attempt 2: c=3 (9GB) - Fallback.
        // Attempt 3: c=4 (13GB) - Original static.
        // Attempt 4: c=6 (18GB) - Ultimate fallback.
        errorStrategy = { task.exitStatus == 143 ? 'retry' : 'ignore' }
        maxRetries = 3
        clusterOptions = { 
            if (task.attempt == 1) return '--rsc p=1:t=2:c=2:m=4571M'
            else if (task.attempt == 2) return '--rsc p=1:t=2:c=3:m=9142M'
            else if (task.attempt == 3) return '--rsc p=1:t=2:c=4:m=13713M'
            else return '--rsc p=1:t=2:c=6:m=18234M'
        }
    }
    withName: 'MergeConcordanceVmiss' {
        // Dynamic Resource Strategy:
        // Attempt 1: c=6 (18GB) - Start High.
        // Attempt 2: c=8 (27GB) - Fallback.
        // Attempt 3: c=10 (36GB) - Ultimate fallback.
        errorStrategy = { task.exitStatus == 143 ? 'retry' : 'ignore' }
        maxRetries = 2
        clusterOptions = { 
            if (task.attempt == 1) return '--rsc p=1:t=2:c=6:m=18234M'
            else if (task.attempt == 2) return '--rsc p=1:t=2:c=8:m=27426M'
            else return '--rsc p=1:t=2:c=10:m=36568M'
        }
    }
}

trace {
    overwrite = true
}
report {
    overwrite = true
}

executor {
    // Concurrency Control:
    // queueSize determines the maximum number of tasks submitted to the scheduler simultaneously.
    // To reserve resources for other scripts, it is recommended to lower this value (e.g., to 15 or 20) to avoid filling the queue.
    queueSize = 20
}