// Nextflow configuration file for tuning.variants.v5 pipeline

// Process resource allocation using cluster options
process {
    withName: 'extractMetrics' {
        clusterOptions = '--rsc p=1:t=8:c=4:m=18284M'
    }
    withName: 'plotDistributions' {
        clusterOptions = '--rsc p=1:t=8:c=4:m=18284M'
    }
    withName: 'countVariants' {
        clusterOptions = '--rsc p=1:t=8:c=4:m=18284M'
    }
    withName: 'mergeChrStats' {
        clusterOptions = '--rsc p=1:t=8:c=4:m=18284M'
    }
}

// Executor configuration
executor {
    queueSize = 25  // Allow parallel processing of all 25 chromosomes
}
